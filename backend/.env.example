# ====================================================================
# BugFlow Django Backend - Environment Configuration Template
# ====================================================================
SECRET_KEY=change-me
DEBUG=True

# ====================================================================
# ACTIVE ENVIRONMENT SWITCH
# Option A: Toggle ACTIVE_ENV between 'local' and 'render'
# Option B: Comment/uncomment the database blocks below
# ====================================================================
ACTIVE_ENV=local
# ACTIVE_ENV=render


# ====================================================================
# 1. LOCAL ENVIRONMENT (Development & Daily Working)
# Database: Local PostgreSQL (cliccot_testflow)
# ====================================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cliccot_testflow
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/cliccot_testflow

# (Alternative) Local SQLite file instead of local PostgreSQL:
# USE_SQLITE=True


# ====================================================================
# 2. RENDER ENVIRONMENT (Render Cloud - Testing Purpose)
# Database: Render PostgreSQL (cliccot_testpilot)
# Uncomment the block below to switch to Render PostgreSQL:
# ====================================================================
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=cliccot_testpilot
# DB_USER=cliccot_testpilot_user
# DB_PASSWORD=your-render-db-password
# DB_HOST=dpg-dbm0lmmc6qcc73fk2dc0-a.oregon-postgres.render.com
# DB_PORT=5432
# DB_SSLMODE=require
# DATABASE_URL=postgresql://cliccot_testpilot_user:your-render-db-password@dpg-dbm0lmmc6qcc73fk2dc0-a.oregon-postgres.render.com/cliccot_testpilot


# ====================================================================
# CORS, CSRF & ALLOWED HOSTS
# ====================================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://cliccot-testpilot-3.onrender.com,https://cliccot-testpilot-backend.onrender.com
CSRF_TRUSTED_ORIGINS=https://cliccot-testpilot-3.onrender.com,https://cliccot-testpilot-backend.onrender.com,https://*.onrender.com,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=*,cliccot-testpilot-3.onrender.com,cliccot-testpilot-backend.onrender.com,.onrender.com,localhost,127.0.0.1
